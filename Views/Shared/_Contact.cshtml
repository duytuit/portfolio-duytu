<div class="text-[#7A6960]">
<h1 class="text-3xl font-semibold text-center">Contact</h1>
<div class="flex justify-center items-center mt-2">
<div class="bg-orange-600 h-1 w-16 rounded">
</div>
</div>
<p class="text-gray-700 text-center mt-7 mb-10 text-lg">Reach out for a new project or just say hello</p>
<div class="lg:flex gap-6">
<div class="lg:w-[40%] px-10 py-5 shadow-xl border-t-[3px] border-b-[3px] border-orange-600 mb-7 lg:mb-0">
<div class="flex gap-3 mt-3 mb-12">
<div class="rounded-full h-fit bg-orange-100 p-2" style="color:#EA580C;font-size:28px">
<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
<path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" d="M256 48c-79.5 0-144 61.39-144 137 0 87 96 224.87 131.25 272.49a15.77 15.77 0 0 0 25.5 0C304 409.89 400 272.07 400 185c0-75.61-64.5-137-144-137">
</path>
<circle cx="256" cy="192" r="48" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32">
</circle>
</svg>
</div>
<div>
<h2 class="lg:text-xl text-[#7A6960] font-semibold">Address</h2>
<p class="text-sm text-slate-800">A108 Adam Street, New York, NY 535022</p>
</div>
</div>
<div class="flex gap-3 mb-12">
<div class="rounded-full h-fit bg-orange-100 p-2" style="color:#EA580C;font-size:28px">
<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
<path fill="none" stroke-miterlimit="10" stroke-width="32" d="M451 374c-15.88-16-54.34-39.35-73-48.76-24.3-12.24-26.3-13.24-45.4.95-12.74 9.47-21.21 17.93-36.12 14.75s-47.31-21.11-75.68-49.39-47.34-61.62-50.53-76.48 5.41-23.23 14.79-36c13.22-18 12.22-21 .92-45.3-8.81-18.9-32.84-57-48.9-72.8C119.9 44 119.9 47 108.83 51.6A160 160 0 0 0 83 65.37C67 76 58.12 84.83 51.91 98.1s-9 44.38 23.07 102.64 54.57 88.05 101.14 134.49S258.5 406.64 310.85 436c64.76 36.27 89.6 29.2 102.91 23s22.18-15 32.83-31a159 159 0 0 0 13.8-25.8C465 391.17 468 391.17 451 374z">
</path>
</svg>
</div>
<div>
<h2 class="lg:text-xl text-[#7A6960] font-semibold">Call Us</h2>
<p class="text-sm text-slate-800">+1 5589 55488 55</p>
</div>
</div>
<div class="flex gap-5 mb-12">
<div class="rounded-full h-fit bg-orange-100 p-2" style="color:#EA580C;font-size:28px">
<svg stroke="currentColor" fill="currentColor" stroke-width="0" version="1.1" viewBox="0 0 17 17" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
<g>
</g>
<path d="M0 2v13h17v-13h-17zM8.494 9.817l-6.896-6.817h13.82l-6.924 6.817zM5.755 8.516l-4.755 4.682v-9.383l4.755 4.701zM6.466 9.219l2.026 2.003 1.996-1.966 4.8 4.744h-13.677l4.855-4.781zM11.201 8.555l4.799-4.725v9.467l-4.799-4.742z">
</path>
</svg>
</div>
<div>
<h2 class="lg:text-xl text-[#7A6960] font-semibold">Email Us</h2>
<p class="text-sm text-slate-800">info@@example.com</p>
</div>
</div>
<div class="lg:w-full lg:h-72">
<iframe width="100%" height="100%" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14010.76256980872!2d77.22260515427726!3d28.60905606083753!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390ce2db961be393%3A0xf6c7ef5ee6dd10ae!2sIndia%20Gate%2C%20New%20Delhi%2C%20Delhi!5e0!3m2!1sen!2sin!4v1717776828829!5m2!1sen!2sin" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
</iframe>
</div>
</div>
<div class="lg:w-[60%] px-10 py-5 shadow-xl border-t-[3px] border-b-[3px] border-orange-600">
<form method="post" action="/contact">
@Html.AntiForgeryToken()
<input type="hidden" name="ReturnPath" value="@(Context.Request.Path)" />
<div class="md:flex gap-6">
<div class="md:w-[50%]">
<div>
<label for="name">Name</label>
<input name="name" type="text" id="name" placeholder="John Doe" class="w-full h-10 px-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none"/ required>
</div>
</div>
<div class="md:w-[50%]">
<div>
<label for="email">Your Email</label>
<input name="email" aria-label="Email" type="email" id="email" placeholder="johndoe@@gmail.com" class="w-full h-10 px-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none"/ required>
</div>
</div>
</div>
<div>
<label for="subject">Subject</label>
<input name="subject" type="text" id="subject" placeholder="Your subject" class="w-full h-10 px-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none"/ required>
</div>
<div>
<label for="message">Message</label>
<textarea name="message" id="message" placeholder="Enter your message" class="w-full h-60 p-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none resize-none" required>
</textarea>
</div>
<div class="flex justify-center m-3">
<button class="bg-orange-600 hover:bg-orange-500 hover:shadow hover:shadow-orange-500 text-lg text-slate-50 rounded-3xl px-4 py-2 w-fit transition-all duration-300">Send Message</button>
</div>
</form>
</div>
</div>
</div>
