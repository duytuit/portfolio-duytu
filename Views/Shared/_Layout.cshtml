<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - Duy Tú</title>
<script>
(() => {
    let theme;
    try { theme = localStorage.getItem('portfolio-theme'); } catch {}
    document.documentElement.dataset.theme = theme === 'dark' || theme === 'light'
        ? theme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
})();
</script>
<link rel="icon" href="~/img/favicon.png" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/aos/aos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/interactions.css" asp-append-version="true" />
</head>
<body class="secondary-font @(ViewData["HeroNavigation"] is true ? "hero-navigation" : "")">
<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
<partial name="_NavBar" />
@if (TempData["Notice"] is string notice) { <div role="status" class="notice">@notice</div> }
@if (TempData["Error"] is string error) { <div role="alert" class="notice error">@error</div> }
<main>@RenderBody()</main>
<script src="~/lib/aos/aos.js" asp-append-version="true" defer></script>
<script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer>
</script>
</body>
</html>
