@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var zaloChatUrl = Configuration["Contact:ZaloUrl"];
    var messengerChatUrl = Configuration["Contact:MessengerUrl"];
    var socialTitle = ViewData["Title"] as string ?? "Duy Tú | Full-stack Developer .NET & ReactJS";
    var socialDescription = ViewData["Description"] as string ?? "Portfolio của Duy Tú, Software Engineer và Full-stack Developer.";
    var socialImageUrl = SeoContent.Origin + "/img/duy-tu-coding-hero.webp";
    var socialPageUrl = SeoContent.Origin + Context.Request.Path;
    var post = ViewData["Post"] as BlogPost;
    var graph = new List<object> {
        new Dictionary<string,object> { ["@type"]="Person", ["@id"]=SeoContent.Origin+"/#person", ["name"]="Duy Tú", ["url"]=SeoContent.Origin+"/about", ["jobTitle"]="Software Engineer & Full-stack Developer" },
        new Dictionary<string,object> { ["@type"]="WebSite", ["@id"]=SeoContent.Origin+"/#website", ["url"]=SeoContent.Origin+"/", ["name"]="Duy Tú", ["inLanguage"]="vi" }
    };
    if (Context.Request.Path == "/about") {
        graph.Add(new Dictionary<string,object> { ["@type"]="ProfilePage", ["@id"]=socialPageUrl+"#webpage", ["url"]=socialPageUrl, ["name"]=socialTitle, ["mainEntity"]=new Dictionary<string,string>{["@id"]=SeoContent.Origin+"/#person"} });
    }
    if (Context.Request.Path != "/") {
        var crumbs = new List<object> { new Dictionary<string,object>{["@type"]="ListItem",["position"]=1,["name"]="Trang chủ",["item"]=SeoContent.Origin+"/"} };
        var section = ViewData["Section"] as string;
        if (Context.Request.Path.Value!.Trim('/').Contains('/') && section is not null) {
            crumbs.Add(new Dictionary<string,object>{["@type"]="ListItem",["position"]=2,["name"]= section == "projects" ? "Dự án" : section == "services" ? "Dịch vụ" : "Blog",["item"]=SeoContent.Origin+"/"+section});
        }
        crumbs.Add(new Dictionary<string,object>{["@type"]="ListItem",["position"]=crumbs.Count+1,["name"]=socialTitle,["item"]=socialPageUrl});
        graph.Add(new Dictionary<string,object>{["@type"]="BreadcrumbList",["itemListElement"]=crumbs});
    }
    if(post is not null) {
        graph.Add(new Dictionary<string,object> { ["@type"]="BlogPosting",["headline"]=post.Title,["description"]=post.Description,["url"]=socialPageUrl,["mainEntityOfPage"]=socialPageUrl,["datePublished"]=post.Published+"T00:00:00+07:00",["dateModified"]=post.Updated+"T00:00:00+07:00",["author"]=new Dictionary<string,string>{["@type"]="Person",["@id"]=SeoContent.Origin+"/#person",["name"]=post.Author,["url"]=SeoContent.Origin+"/about"},["image"]=socialImageUrl,["inLanguage"]="vi" });
    }
    var structuredData = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string,object> { ["@context"]="https://schema.org",["@graph"]=graph });
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@socialTitle</title>
<link rel="canonical" href="@socialPageUrl" />
<script type="application/ld+json">@Html.Raw(structuredData)</script>
<meta name="description" content="@socialDescription" />
<meta property="og:type" content="@(post is null ? "website" : "article")" />
<meta property="og:locale" content="vi_VN" />
<meta property="og:site_name" content="Duy Tú" />
<meta property="og:title" content="@socialTitle" />
<meta property="og:description" content="@socialDescription" />
<meta property="og:url" content="@socialPageUrl" />
<meta property="og:image" content="@socialImageUrl" />
<meta property="og:image:alt" content="Portfolio của Duy Tú" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="@socialTitle" />
<meta name="twitter:description" content="@socialDescription" />
<meta name="twitter:image" content="@socialImageUrl" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&amp;family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&amp;display=swap" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<script>
(() => {
    let theme;
    try { theme = localStorage.getItem('portfolio-theme'); } catch {}
    document.documentElement.dataset.theme = theme === 'dark' || theme === 'light'
        ? theme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
})();
</script>
<link rel="icon" href="~/img/favicon.ico" sizes="32x32" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/aos/aos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/interactions.css" asp-append-version="true" />
</head>
<body class="secondary-font @(ViewData["HeroNavigation"] is true ? "hero-navigation" : "")">
<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
<partial name="_NavBar" />
<div class="toast-container">
@if (TempData["Notice"] is string notice)
{
    <div role="status" class="feedback-toast" data-toast>
        <span class="toast-icon" aria-hidden="true">✓</span>
        <span class="toast-message">@notice</span>
        <button type="button" class="toast-close" data-toast-close aria-label="Đóng thông báo">×</button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div role="alert" class="feedback-toast toast-error" data-toast>
        <span class="toast-icon" aria-hidden="true">!</span>
        <span class="toast-message">@error</span>
        <button type="button" class="toast-close" data-toast-close aria-label="Đóng thông báo">×</button>
    </div>
}
</div>
<main>@RenderBody()</main>
@if (!string.IsNullOrWhiteSpace(messengerChatUrl))
{
    <a class="zalo-chat messenger-chat" href="@messengerChatUrl" target="_blank" rel="noopener noreferrer"
       aria-label="Chat qua Messenger (mở tab mới)" title="Chat qua Messenger">
        <img src="~/img/icon-messenger.svg" asp-append-version="true" width="60" height="60" alt="" />
    </a>
}
else
{
    <button class="zalo-chat messenger-chat" type="button" disabled aria-label="Chat qua Messenger chưa được cấu hình"
            title="Chưa cấu hình đường dẫn Messenger">
        <img src="~/img/icon-messenger.svg" asp-append-version="true" width="60" height="60" alt="" />
    </button>
}
@if (!string.IsNullOrWhiteSpace(zaloChatUrl))
{
    <a class="zalo-chat" href="@zaloChatUrl" target="_blank" rel="noopener noreferrer"
       aria-label="Chat qua Zalo (mở tab mới)" title="Chat qua Zalo">
        <img src="~/img/icon-zalo.svg" asp-append-version="true" width="50" height="50" alt="" />
    </a>
}
else
{
    <button class="zalo-chat" type="button" disabled aria-label="Chat qua Zalo chưa được cấu hình"
            title="Chưa cấu hình đường dẫn Zalo">
        <img src="~/img/icon-zalo.svg" asp-append-version="true" width="50" height="50" alt="" />
    </button>
}
<script src="~/lib/aos/aos.js" asp-append-version="true" defer></script>
<script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer>
</script>
</body>
</html>
