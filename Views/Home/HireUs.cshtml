@{ ViewData["Title"] = "Hire Us"; }
<div class="">
<h1 class="text-center text-[#7A6960] md:text-5xl text-3xl font-semibold my-10 p-5 md:p-0">Share your idea &amp; we will <br/> turn it into reality!</h1>
<div class="w-full min-h-screen flex justify-center">
<div data-aos="fade-up" data-aos-duration="1600" class="lg:w-[60%] h-fit px-10 py-5 shadow-xl border-t-[3px] border-b-[3px] border-orange-600 bg-white">
<form method="post" action="/contact">
@Html.AntiForgeryToken()
<input type="hidden" name="ReturnPath" value="@(Context.Request.Path)" />
<div class="md:flex gap-6">
<div class="md:w-[50%]">
<div>
<label for="name">Name</label>
<input name="name" type="text" id="name" placeholder="John Doe" class="w-full h-10 px-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none"/ required>
</div>
</div>
<div class="md:w-[50%]">
<div>
<label for="email">Your Email</label>
<input name="email" aria-label="Email" type="email" id="email" placeholder="johndoe@@gmail.com" class="w-full h-10 px-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none"/ required>
</div>
</div>
</div>
<div>
<label for="subject">Subject</label>
<input name="subject" type="text" id="subject" placeholder="Your subject" class="w-full h-10 px-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none"/ required>
</div>
<div>
<label for="message">Message</label>
<textarea name="message" id="message" placeholder="Enter your message" class="w-full h-60 p-3 my-3 rounded border border-zinc-300 focus:border focus:border-orange-600 outline-none resize-none" required>
</textarea>
</div>
<div class="flex justify-center m-3">
<button class="bg-orange-600 hover:bg-orange-500 hover:shadow hover:shadow-orange-500 text-lg text-slate-50 rounded-3xl px-4 py-2 w-fit transition-all duration-300">Send Message</button>
</div>
</form>
</div>
</div>
<section class="w-full max-h-fit py-16 lg:px-32 overflow-hidden bg-[#FEFAF8] border-b border-orange-100 mt-20 md:mt-0">
<partial name="_Newsletter" />
</section>
<section class="w-full max-h-fit py-16 lg:px-32 overflow-hidden border-b border-orange-100">
<partial name="_Footer" />
</section>
</div>
