@model PortfolioMvc.Modules.VideoTrimmer.Models.VideoTrimmerPageModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cắt video bằng FFmpeg | Duy Tú";
    ViewData["Description"] = "Tải video lên, chia thành các đoạn theo số giây tùy chọn và tải từng đoạn về.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/video-trimmer.css" asp-append-version="true" />
}

<section class="video-tool">
    <div class="video-tool__inner">
        <header class="video-tool__hero">
            <p class="video-tool__eyebrow"><span aria-hidden="true"></span> CÔNG CỤ VIDEO <span class="video-tool__eyebrow-index">FFMPEG</span></p>
            <h1>Chia video thành<br class="video-tool__desktop-break" /> từng đoạn.</h1>
            <p class="video-tool__intro">Tách video dài thành những clip ngắn, sẵn sàng để chia sẻ. Chọn thời lượng cho mỗi đoạn, FFmpeg sẽ xử lý phần còn lại.</p>
            <div class="video-tool__badges" aria-label="Thông tin công cụ">
                <span><strong>500 MB</strong> tối đa</span>
                <span><strong>2 giờ</strong> thời lượng</span>
                <span><strong>Riêng tư</strong> theo trình duyệt</span>
            </div>
        </header>

        <form class="video-tool__upload" asp-controller="VideoTrimmer" asp-action="Cut" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="video-tool__form-grid">
                <div class="video-tool__file-field">
                    <label class="video-tool__field-label" for="video-file">01 <span>VIDEO ĐẦU VÀO</span></label>
                    <input id="video-file" class="video-tool__file-input" type="file" name="video" accept=".mp4,.mov,.mkv,.avi,.webm,.m4v,video/*" required />
                    <label class="video-tool__dropzone" for="video-file" data-video-dropzone>
                        <span class="video-tool__upload-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4m0 0L7 9m5-5 5 5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" /></svg>
                        </span>
                        <span class="video-tool__dropzone-copy">
                            <strong data-video-file-name>Chọn video để bắt đầu</strong>
                            <span data-video-file-hint>Kéo tệp vào đây hoặc nhấn để duyệt</span>
                        </span>
                        <span class="video-tool__browse">Chọn tệp <span aria-hidden="true">↗</span></span>
                    </label>
                    <p class="video-tool__formats">MP4, MOV, MKV, AVI, WEBM, M4V <span>·</span> Tối đa 500 MB</p>
                </div>

                <div class="video-tool__settings">
                    <label class="video-tool__field-label" for="segment-seconds">02 <span>THỜI LƯỢNG MỖI ĐOẠN</span></label>
                    <div class="video-tool__duration-input">
                        <input id="segment-seconds" type="number" name="segmentSeconds" value="10" min="1" max="3600" required />
                        <span>giây</span>
                    </div>
                    <p class="video-tool__duration-note">Đoạn cuối có thể ngắn hơn nếu video không chia hết.</p>
                    <button class="video-tool__button" type="submit" data-cut-button>
                        <span>Cắt video</span><span class="video-tool__button-arrow" aria-hidden="true">↗</span>
                    </button>
                </div>
            </div>
            <p class="video-tool__privacy"><span aria-hidden="true">↳</span> Tệp được xử lý riêng tư trên máy chủ và tự dọn sau 24 giờ.</p>
        </form>

        <div class="video-tool__list-heading">
            <div>
                <p class="video-tool__eyebrow"><span aria-hidden="true"></span> THƯ VIỆN CỦA BẠN</p>
                <h2>Video đã cắt</h2>
            </div>
            <span class="video-tool__count">@Model.Clips.Count <span>clip</span></span>
        </div>

        @if (Model.Clips.Count == 0)
        {
            <div class="video-tool__empty">
                <span class="video-tool__empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3V9Z"/></svg>
                </span>
                <strong>Chưa có clip nào</strong>
                <span>Tải video lên và chọn thời lượng để tạo những đoạn đầu tiên.</span>
            </div>
        }
        else
        {
            <form asp-controller="VideoTrimmer" asp-action="Delete" method="post" data-video-delete-form>
                @Html.AntiForgeryToken()
                <div class="video-tool__bulk-actions">
                    <label class="video-tool__select-all">
                        <input type="checkbox" data-select-all />
                        <span>Chọn tất cả</span>
                    </label>
                    <button class="video-tool__button video-tool__button--danger" type="submit" data-delete-selected disabled>
                        <span aria-hidden="true">×</span> Xóa đã chọn
                    </button>
                </div>
                <div class="video-tool__table-wrap">
                    <table class="video-tool__table">
                        <thead>
                            <tr>
                                <th scope="col"><span class="video-tool__sr-only">Chọn</span></th>
                                <th scope="col">Tên video</th>
                                <th scope="col">Thời lượng</th>
                                <th scope="col">Ngày tạo</th>
                                <th scope="col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var clip in Model.Clips)
                            {
                                <tr>
                                    <td>
                                        <input class="video-tool__clip-checkbox" type="checkbox" name="ids" value="@clip.Id" aria-label="Chọn đoạn @clip.ClipNumber của @clip.OriginalFileName" />
                                    </td>
                                    <td>
                                        <span class="video-tool__filename">@($"{System.IO.Path.GetFileNameWithoutExtension(clip.OriginalFileName)}_part_{clip.ClipNumber:D3}.mp4")</span>
                                        <span class="video-tool__subtext">CLIP @clip.ClipNumber.ToString("D3")</span>
                                    </td>
                                    <td>@clip.DurationSeconds.ToString("0.##") giây</td>
                                    <td><time datetime="@clip.CreatedUtc.ToString("O")">@clip.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></td>
                                    <td class="video-tool__actions">
                                        <a class="video-tool__download" href="/tools/video-trimmer/download/@clip.Id">Tải MP4 <span aria-hidden="true">↓</span></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/video-trimmer.js" asp-append-version="true" defer></script>
}
